{
  "name": "ads-search-simulator",
  "version": "0.3.0",
  "description": "Google Ads search auction simulator, built as a learning tool for paid search advertising",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node dev-server.js",
    "test": "eslint . && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-site.js",
    "preview": "node scripts/build-site.js && node dev-server.js dist",
    "ci": "eslint . && vitest run --testTimeout=60000 --hookTimeout=60000 && node scripts/build-site.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0"
  }
}
